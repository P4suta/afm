# Node (for the playground)
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Fuzz (cargo-fuzz crates live at crates/<crate>/fuzz/, e.g.
# crates/aozora-flavored-markdown/fuzz/ — the bare `fuzz/*` form matched a
# nonexistent top-level dir and never ignored anything).
crates/*/fuzz/target/
crates/*/fuzz/artifacts/
# A corpus directory is two things at once: libFuzzer's scratch space, where
# every input it finds interesting lands under a SHA-1 name, and the seed set
# it starts from. The first is machine output and stays out of git; the second
# is the repo's own example documents, installed by `just fuzz-seed` under a
# `seed-` prefix, so a clean clone (and every CI run) starts from valid
# markdown instead of mutating an empty byte string for the first minute.
#
# Spelled as "files inside a target's directory" rather than the directory
# itself on purpose: git cannot re-include a path below an excluded directory,
# so ignoring `corpus/` wholesale would make the negation below dead text.
crates/*/fuzz/corpus/*/*
!crates/*/fuzz/corpus/*/seed-*

# Criterion
/target/criterion/

# dhat heap-profile output (written to the workspace root by `just dhat`)
dhat-heap.json

# Local env overrides
.env
.env.local

# Ad-hoc scratch files (render outputs, debug dumps, …)
.tmp-*

# macOS junk in WSL mounts
:2e*

# Personal Claude Code settings (do not check in)
.claude/settings.local.json
.claude/scheduled_tasks.lock
CLAUDE.md
CLAUDE.local.md
