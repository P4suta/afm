#!/usr/bin/env bash
# xtask — project automation. `bin/xtask --help` lists the sub-commands; the
# clap `enum Command` in crates/xtask/src/main.rs is where they are declared.
# Always runs inside the dev container.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

cd "$REPO_ROOT"

exec docker compose run --rm dev \
    cargo run --quiet --package xtask -- "$@"
