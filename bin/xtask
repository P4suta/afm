#!/usr/bin/env bash
# xtask — project automation (comment-discipline, new-adr, spec-refresh,
# aozora-bump, gen-dist-assets). Always runs inside the dev container.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "$SCRIPT_DIR/.." && pwd)"

cd "$REPO_ROOT"

exec docker compose run --rm dev \
    cargo run --quiet --package xtask -- "$@"
