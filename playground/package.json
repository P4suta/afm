{
  "name": "aozora-md-playground",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "React 19 and Spectrum 2 authoring playground for Aozora Flavored Markdown.",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite",
    "build": "bun run typecheck && vite build",
    "preview": "vite preview",
    "preview:production": "bun scripts/serve-production.ts",
    "typecheck": "tsc --noEmit && tsc --project tsconfig.node.json --noEmit",
    "lint": "biome check --formatter-enabled=true --linter-enabled=true --error-on-warnings .",
    "lint:fix": "biome check --formatter-enabled=true --linter-enabled=true --write .",
    "lint:css": "stylelint --config ./.stylelintrc.json 'src/**/*.css' '../crates/aozora-flavored-markdown/theme/*.css'",
    "lint:css:fix": "stylelint --fix --config ./.stylelintrc.json 'src/**/*.css' '../crates/aozora-flavored-markdown/theme/*.css'",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "e2e": "bun run build && playwright test",
    "lighthouse": "bun scripts/run-lighthouse.ts",
    "check:bundle": "bun scripts/check-bundle-budget.ts",
    "check:legacy": "bun scripts/check-legacy.ts",
    "vendor:sync": "bun scripts/sync-playground-ui.ts",
    "vendor:verify": "bun scripts/verify-playground-ui.ts"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.10.6",
    "@codemirror/lint": "^6.8.5",
    "@codemirror/search": "^6.5.8",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@lezer/highlight": "^1.2.1",
    "@aozora/playground-ui": "file:vendor/playground-ui",
    "@react-spectrum/s2": "^1.5.1",
    "aozora-flavored-markdown-wasm": "file:../crates/aozora-flavored-markdown-wasm/pkg",
    "codemirror": "^6.0.1",
    "lz-string": "^1.5.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@biomejs/biome": "^2.5.5",
    "@lhci/cli": "^0.15.1",
    "@playwright/test": "^1.62.0",
    "@react-aria/optimize-locales-plugin": "^2.0.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "happy-dom": "^20.11.1",
    "lightningcss": "^1.33.0",
    "stylelint": "^17.14.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^5.7.2",
    "unplugin-parcel-macros": "^0.2.0",
    "vite": "^8.0.14",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.10"
  },
  "browserslist": "last 2 Chrome versions, last 2 Safari versions, last 2 Firefox versions, last 2 Edge versions"
}
