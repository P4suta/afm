{
  "name": "aozora-md-playground",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "Browser playground for aozora-flavored-markdown (aozora-md). Solid + Vite frontend over the aozora-flavored-markdown-wasm crate, managed by bun.",
  "packageManager": "bun@1.3.14",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "lint": "biome check --formatter-enabled=true --linter-enabled=true --error-on-warnings .",
    "lint:fix": "biome check --formatter-enabled=true --linter-enabled=true --write .",
    "test": "vitest run"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.2",
    "@codemirror/commands": "^6.7.1",
    "@codemirror/lang-markdown": "^6.3.0",
    "@codemirror/language": "^6.10.6",
    "@codemirror/lint": "^6.8.5",
    "@codemirror/search": "^6.5.8",
    "@codemirror/state": "^6.5.0",
    "@codemirror/view": "^6.36.0",
    "@lezer/highlight": "^1.2.1",
    "aozora-flavored-markdown-wasm": "file:../crates/aozora-flavored-markdown-wasm/pkg",
    "codemirror": "^6.0.1",
    "lz-string": "^1.5.0",
    "marked": "^14.1.3",
    "solid-js": "^1.9.3"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.5",
    "@solidjs/testing-library": "^0.8.10",
    "happy-dom": "^20.11.1",
    "typescript": "^5.7.2",
    "vite": "^8.0.14",
    "vite-plugin-solid": "^2.11.0",
    "vite-plugin-wasm": "^3.6.0",
    "vitest": "^4.1.10"
  }
}
